    "test:emergency": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/emergency.test.js --runInBand",
    "test:appointments": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/appointment.test.js --runInBand",
